# ==========================================================================
# .env.example raiz — Lê Ai (P0-INFRA)
# Valores COMPARTILHADOS de referência. Cada subprojeto tem seu próprio
# .env.example (ex.: code/back/<servico>/.env.example). Copie para .env e
# preencha; o .env NUNCA é versionado (RNF-SEC-11).
# ==========================================================================

# Banco — um projeto Neon POR AMBIENTE, um schema por serviço (arquitetura §4.1, §6).
# Sem replicação entre eles (P0-DEPLOY, "Ambientes de dados"). O .env local usa o de DEV.
# Role leaidb_prd e banco leai-db-prd nos dois; a senha fica fora do repositório.
NEON_HOST_DEV=ep-soft-violet-ac5dmubm.sa-east-1.aws.neon.tech
NEON_HOST_DES=ep-lively-bread-ar07oy7t.c-4.us-west-2.aws.neon.tech
# Modelo por serviço Nest (host direto aceita o options; o host -pooler não):
# DATABASE_URL=postgresql://<user>:<pass>@<host>/<db>?sslmode=require&options=-csearch_path%3D<servico>
# Modelo por serviço Spring:
# DATABASE_URL=jdbc:postgresql://<host>/<db>?sslmode=require

# Mensageria — RabbitMQ no CloudAMQP, uma instância POR AMBIENTE (uma conexão por serviço) — ver P0-MSG.
AMQP_HOST_DEV=jackal.rmq.cloudamqp.com
AMQP_HOST_DES=beaver.rmq.cloudamqp.com
# AMQP_URL=amqps://<user>:<pass>@<host>/<vhost>

# CORS — origens conhecidas dos clientes por ambiente (sem curinga, RNF-SEC-21).
CORS_ALLOWED_ORIGINS_LOCAL=http://localhost:5173
CORS_ALLOWED_ORIGINS_DES=https://leai-web.onrender.com
