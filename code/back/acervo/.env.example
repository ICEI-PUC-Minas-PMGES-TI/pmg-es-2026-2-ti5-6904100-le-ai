# ==========================================================================
# acervo — exemplo de variáveis de ambiente (P0-INFRA)
# Copie para .env e preencha. O .env NUNCA é versionado (RNF-SEC-11).
# ==========================================================================

# Ambiente / servidor
NODE_ENV=development
PORT=3000

# Banco — projeto único Neon, schema por serviço (arquitetura §4.1)
DATABASE_URL=postgresql://<user>:<pass>@<host>/<db>?options=-csearch_path%3Dacervo
DB_SCHEMA=acervo

# Mensageria (ver P0-MSG)
AMQP_URL=amqps://<user>:<pass>@<host>/<vhost>
AMQP_ENABLED=false

# Observabilidade / erro
LOG_LEVEL=info
SERVICE_NAME=acervo

# Segurança
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Validação do token de acesso emitido pelo `identidade` (F-ACV-CADASTRO).
# Precisa ser EXATAMENTE o mesmo valor configurado no serviço identidade: ele
# assina em HS256 com os bytes UTF-8 desta string. Mínimo de 32 caracteres, que
# é o que o Nimbus exige do lado emissor. Obrigatório em produção; ausente em
# desenvolvimento, o serviço sobe e toda rota autenticada responde 401.
JWT_SECRET=            # segredo forte, aleatório e provisionado por ambiente

# Admin fixo e único, provisionado por ambiente (RF-AUT-08, RNF-SEC-31)
ADMIN_EMAIL=
ADMIN_PASSWORD=        # senha forte, distinta de qualquer default

# ==========================================================================
# Fontes externas do cadastro por ISBN (RNF-SEC-38/39, RNF-ERR-08)
# A URL é sempre construída pelo servidor a partir desta allowlist — o
# endpoint nunca aceita URL do usuário. Host é comparado por igualdade exata.
# ==========================================================================
FONTES_HOSTS_PERMITIDOS=openlibrary.org,covers.openlibrary.org,www.googleapis.com
FONTES_TIMEOUT_MS=5000
FONTES_LIMITE_RESPOSTA_BYTES=1048576
GOOGLE_BOOKS_API_KEY=  # opcional; sem chave a cota é bem menor (§10.1, P-14)

# ==========================================================================
# Capa de livro pessoal (RNF-SEC-20, RN-14.7)
# O upload vai direto do cliente ao Cloudinary; o servidor só valida que a URL
# aponta para o nosso próprio serviço de imagens e nunca faz fetch dela.
# ==========================================================================
CLOUDINARY_CLOUD_NAME=leai
CAPA_HOSTS_PERMITIDOS=res.cloudinary.com
