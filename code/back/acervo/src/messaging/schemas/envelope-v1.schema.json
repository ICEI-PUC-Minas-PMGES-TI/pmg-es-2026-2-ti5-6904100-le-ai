{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leai.app/schemas/mensageria/envelope-v1.schema.json",
  "title": "Envelope de evento v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "type", "version", "occurredAt", "correlationId", "businessKey", "data"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "type": { "type": "string", "pattern": "^[a-z]+(?:[._][a-z]+)+$" },
    "version": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "format": "uuid" },
    "businessKey": { "type": "string", "minLength": 1, "maxLength": 255 },
    "data": { "type": "object" }
  }
}
