# ==========================================================================
# leitura — exemplo de variáveis de ambiente (P0-INFRA)
# Copie para .env e preencha. O .env NUNCA é versionado (RNF-SEC-11).
# ==========================================================================

# Ambiente / servidor
NODE_ENV=development
PORT=3001                 # a 3000 é do acervo; os dois sobem juntos em local

# Banco — projeto único Neon, schema por serviço (arquitetura §4.1)
DATABASE_URL=postgresql://<user>:<pass>@<host>/<db>?options=-csearch_path%3Dleitura
DB_SCHEMA=leitura

# Mensageria (ver P0-MSG)
AMQP_URL=amqps://<user>:<pass>@<host>/<vhost>
AMQP_ENABLED=false

# Observabilidade / erro
LOG_LEVEL=info
SERVICE_NAME=leitura

# Segurança
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=            # MESMO valor do identidade, com 32+ caracteres; sem ele toda rota autenticada dá 401

# Admin fixo e único, provisionado por ambiente (RF-AUT-08, RNF-SEC-31)
ADMIN_EMAIL=
ADMIN_PASSWORD=        # senha forte, distinta de qualquer default
