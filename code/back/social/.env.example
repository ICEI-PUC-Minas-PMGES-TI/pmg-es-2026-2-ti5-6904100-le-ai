# ==========================================================================
# social — exemplo de variáveis de ambiente (P0-INFRA)
# Copie para .env e preencha. O .env NUNCA é versionado (RNF-SEC-11).
#
# ATENÇÃO: no Spring o .env é lido como arquivo .properties, não como dotenv.
# Consequências: comentário só no começo da linha (nada de "CHAVE=x # nota"),
# valor sem aspas, e "\" é caractere de escape (senha com "\" vira "\\").
# ==========================================================================

# Ambiente / servidor
SPRING_PROFILES_ACTIVE=default
PORT=8081

# Banco — projeto único Neon, schema por serviço (arquitetura §4.1).
# Formato JDBC: diferente dos serviços Nest, o driver Java não aceita
# usuário:senha embutidos na URL — eles vêm nas duas variáveis abaixo.
DATABASE_URL=jdbc:postgresql://<host>/<db>?sslmode=require
DATABASE_USERNAME=<user>
DATABASE_PASSWORD=<pass>
DB_SCHEMA=social

# Aplica a migration no boot. false sobe o serviço sem banco (dev).
FLYWAY_ENABLED=true

# Mensageria (ver P0-MSG — ainda não consumida por este serviço)
AMQP_URL=amqps://<user>:<pass>@<host>/<vhost>

# Observabilidade / erro
# Valores aceitos: trace, debug, info, warn, error, fatal, off
LOG_LEVEL=info
SERVICE_NAME=social

# Segurança
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Segredo forte, aleatório e provisionado por ambiente
JWT_SECRET=

# Admin fixo e único, provisionado por ambiente (RF-AUT-08, RNF-SEC-31)
ADMIN_EMAIL=
# Senha forte, distinta de qualquer default
ADMIN_PASSWORD=
