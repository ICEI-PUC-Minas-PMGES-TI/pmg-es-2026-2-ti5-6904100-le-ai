<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- BOM do Spring Boot: fixa a versão de toda dependência transitiva. É o que faz o papel
       do lockfile exigido pela RNF-SEC-25 (Maven não tem lockfile), junto do enforcer abaixo,
       que proíbe faixa de versão. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>br.com.leai</groupId>
  <artifactId>leai-social</artifactId>
  <version>0.0.1</version>
  <name>leai-social</name>
  <description>Lê Ai — serviço social (Spring Boot)</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- Fora do BOM do Boot: precisa de versão explícita. springdoc 3.x é a linha do Boot 4.x. -->
    <springdoc.version>3.1.1</springdoc.version>
  </properties>

  <dependencies>
    <!-- Web MVC. No Boot 4.x substitui spring-boot-starter-web, que ficou deprecado. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <!-- Bean Validation: valida entrada (RNF-SEC-13) e as @ConfigurationProperties do boot. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!-- No Boot 4.x a autoconfiguração foi partida em módulos: sem este, o flyway-core fica
         no classpath mas NUNCA roda, e o serviço sobe com o schema por criar, em silêncio. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <!-- Obrigatório desde o Flyway 10: o suporte a PostgreSQL vive em módulo próprio. Sem ele,
         o boot falha com "No database found to handle jdbc:postgresql://...". -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- OpenAPI em runtime: spec em /v3/api-docs e Swagger UI em /docs (RNF-ARQ-03). -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Novo no Boot 4.x: as fatias @WebMvcTest/MockMvc saíram do starter-test. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Já vem transitivo do starter-test; declarado explicitamente só para o surefire
         conseguir resolver o caminho do jar e carregá-lo como agente (ver plugin abaixo). -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- Publica o caminho de cada dependência como propriedade, para o surefire abaixo
           conseguir apontar o -javaagent para o jar do Mockito. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>caminhos-das-dependencias</id>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Mockito como agente Java: sem isto ele se auto-anexa à JVM, o que os JDKs
           futuros vão recusar. Só silencia o aviso, não muda o comportamento. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
        </configuration>
      </plugin>

      <!-- Falha cedo e com mensagem clara em JDK errado, e proíbe faixa de versão: build
           determinístico com versões fixadas (RNF-SEC-25). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>regras-do-projeto</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <banDynamicVersions/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
