VITE_API_BASE_URL=http://localhost:3000

# Base URL do serviço identidade (P0-NAV) — cadastro, login e /me. Decisão de 12/09:
# URL por serviço, sem gateway único.
VITE_IDENTIDADE_BASE_URL=http://localhost:8080

# Base URL do serviço acervo (F-ACV-CADASTRO): cadastro por ISBN e livro pessoal.
VITE_ACERVO_BASE_URL=http://localhost:3000

# Capa de livro pessoal (F-ACV-CADASTRO, P-09), enviada direto do navegador ao Cloudinary.
# O cloud precisa ser o mesmo de CLOUDINARY_CLOUD_NAME no acervo; o preset é UNSIGNED e
# público por natureza (aceita só jpg/png/webp e grava na pasta "capas").
VITE_CLOUDINARY_CLOUD_NAME=leai
VITE_CLOUDINARY_UPLOAD_PRESET=leai_capas
