# Passe a URL ao executar com:
# flutter run --dart-define=API_BASE_URL=https://api-des.exemplo.com
API_BASE_URL=http://localhost:8080

# Uma URL por serviço, sem gateway (decisão de 12/09). No AVD o host é 10.0.2.2.
IDENTIDADE_BASE_URL=http://localhost:8080
ACERVO_BASE_URL=http://localhost:3000

# Capa de livro pessoal (F-ACV-CADASTRO, P-09). O cloud precisa ser o mesmo de
# CLOUDINARY_CLOUD_NAME no acervo; o preset é UNSIGNED e público por natureza.
# Sem preset, o envio de capa falha com a mensagem de erro de envio.
CLOUDINARY_CLOUD_NAME=leai
CLOUDINARY_UPLOAD_PRESET=
