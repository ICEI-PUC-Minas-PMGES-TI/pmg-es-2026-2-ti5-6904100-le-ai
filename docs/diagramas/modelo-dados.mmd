erDiagram
  %% ===================================================================
  %% Modelo de dados (visão lógica de domínio) — LeAI
  %% Derivado de docs/orquestador/REQUISITOS.md §3/§5/§6 e
  %% docs/orquestador/documento-de-arquitetura.md §3/§4. Não editar isoladamente.
  %% ---
  %% Convenção: linhas de relação só existem DENTRO de um schema.
  %% Referência entre schemas é atributo anotado "-> schema.entidade",
  %% NUNCA aresta/FK física. Consulta relacional ocorre só por VIEW do dono;
  %% IDs também podem chegar por contrato HTTP ou evento versionado.
  %% Legenda: PK/FK/UK = chave · (SEC-nn) segurança · (RN-nn) regra ·
  %% (P2/P3) período em que o campo/entidade entra (Essencial=P1, sem marca).
  %% PENDENTE = decisão registrada no plano, mas ainda não fechada; não migrar
  %% o elemento condicionado antes da decisão humana.
  %% Contratos entre schemas (sem FK/aresta): v_perfil_referencia_v1,
  %% v_seguimento_aceito_v1, v_livro_referencia_v1, v_estante_publica_v1,
  %% v_resenha_publicacao_v1, v_nota_publicacao_v1,
  %% v_atividade_livro_pessoal_v1 e v_lista_livro_pessoal_v1.
  %% Previsto para F-REC-ALG/P3: v_livro_recomendacao_v1 com livro oficial,
  %% autor, série e assuntos; fechar no arquivo da feature antes da migration.
  %% ===================================================================

  %% ============================= schema identidade =============================
  USUARIO ||--o{ REFRESH_TOKEN : "possui"
  USUARIO ||--o{ RESET_TOKEN : "solicita"
  USUARIO ||--o{ SEGUIDOR : "segue / é seguido"
  USUARIO ||--o{ SOLICITACAO_SEGUIR : "solicita / recebe"

  USUARIO {
    uuid id PK "opaco, não-sequencial (SEC-05)"
    citext username UK "único (AUT-01)"
    citext email UK "único"
    string senha_hash "Argon2/bcrypt/scrypt (SEC-09)"
    string nome_exibicao
    string biografia "nullable"
    string avatar_url "Cloudinary, nullable (SOC-01)"
    string avatar_asset_id "remoção no Cloudinary, privado, nullable"
    date data_nascimento "≥18 anos (SEC-43)"
    enum privacidade "publico|privado (RN-08)"
    bool suspenso "admin (MOD-04, P3)"
    bool opt_out_recomendacao "PENDENTE §10.7; não migrar antes da decisão"
    int qtd_seguidores "contador"
    int qtd_seguidos "contador"
    timestamp exclusao_solicitada_em "fluxo LGPD (P2), nullable"
    timestamp anonimizado_em "PENDENTE política remover vs anonimizar, nullable"
    timestamp criado_em
    timestamp atualizado_em
  }
  REFRESH_TOKEN {
    uuid id PK "não-sequencial"
    uuid usuario_id FK
    string token_hash "hash, nunca raw; revogável (SEC-30)"
    bool revogado "invalidado no logout/troca de senha"
    timestamp expira_em
    timestamp criado_em
  }
  RESET_TOKEN {
    uuid id PK
    uuid usuario_id FK
    string token_hash "aleatório cripto, armazenado como hash (SEC-10)"
    bool consumido "uso único"
    timestamp expira_em "≤ 1h (SEC-10)"
    timestamp criado_em
  }
  SEGUIDOR {
    uuid id PK
    uuid seguidor_id FK "→ usuario"
    uuid seguido_id FK "→ usuario; UK composto com seguidor_id"
    timestamp criado_em
  }
  SOLICITACAO_SEGUIR {
    uuid id PK
    uuid solicitante_id FK "→ usuario"
    uuid alvo_id FK "→ usuario"
    enum status "pendente|aceita|recusada (SOC-06, RN-08)"
    timestamp criado_em
    timestamp resolvido_em "nullable; UK parcial do par enquanto pendente"
  }
  TENTATIVA_LOGIN {
    string identidade PK "email/username alvo"
    int falhas
    timestamp bloqueado_ate "lockout progressivo por identidade (SEC-29)"
    timestamp ultima_tentativa
  }
  EXCLUSAO_CONTA {
    uuid id PK "recibo técnico sem PII (P2)"
    uuid usuario_ref "subject opaco; sem FK para sobreviver à limpeza"
    string chave_idempotencia "UK com usuario_ref"
    timestamp criado_em
    timestamp expira_em "retenção curta"
  }
  IDEMPOTENCIA_IDENTIDADE {
    uuid id PK "ledger HTTP técnico"
    uuid subject_ref "usuário/cliente opaco"
    string operacao "rota + ação"
    string chave
    string payload_hash "conflito se payload mudar"
    int status_http
    json resposta
    timestamp criado_em
    timestamp expira_em "UK(subject_ref,operacao,chave)"
  }

  %% PENDENTE identidade: aprovar conta.excluida ou orquestração síncrona;
  %% fechar matriz remover/anonimizar antes da migration de F-CONTA-2.

  %% ============================= schema acervo =============================
  EDITORA ||--o{ LIVRO : "publica"
  SERIE ||--o{ LIVRO : "agrupa"
  LIVRO ||--o{ LIVRO_AUTOR : "tem"
  AUTOR ||--o{ LIVRO_AUTOR : "escreve"
  LIVRO ||--o{ LIVRO_ASSUNTO : "classificado"
  ASSUNTO ||--o{ LIVRO_ASSUNTO : "classifica"
  LIVRO ||--o{ NOTA_LEITOR_PROJECAO : "recebe projeções"
  LIVRO ||--o| NOTA_LIVRO_AGREGADA : "agrega"
  LIVRO o|--o{ IMPORTACAO_LIVRO : "resulta de"
  EDITORA ||--o{ SINONIMO_EDITORA : "normaliza"
  ASSUNTO ||--o{ MAPA_ASSUNTO_EXTERNO : "mapeia"

  LIVRO {
    uuid id PK "não-sequencial (SEC-05)"
    string isbn13 UK "único p/ oficial; AUSENTE em pessoal (RN-02); partial-unique WHERE not null"
    string ol_edition_key UK "id dedup fonte externa (RN-02), nullable; UK parcial"
    string titulo
    string autor_informado "obrigatório só em pessoal; não cria AUTOR"
    int ano_publicacao "nullable"
    int paginas "obrigatório — progresso por página exige (RN-12)"
    string sinopse "texto puro ≤4000, sob demanda (RN-19), nullable"
    enum sinopse_status "nao_consultada|pendente|disponivel|ausente|falha_transitoria (RN-19)"
    string capa_url_externa "obrigatória em oficial; ausente em pessoal (RN-14)"
    string capa_url_propria "cache oficial ou upload pessoal, nullable"
    string capa_asset_id "remoção no Cloudinary, privado, nullable"
    decimal nota_geral "externa, somente leitura (RN-06, ACV-15), nullable"
    int nota_geral_qtd "qtd avaliações da origem, nullable"
    enum tipo "oficial|pessoal (RN-02/03)"
    uuid dono_id "→ usuario; só livro pessoal (RN-03/SEC-06), nullable"
    uuid editora_id FK "nullable"
    uuid serie_id FK "nullable"
    int numero_serie "ordem na série (RN-12), nullable"
    bool ativo "exclusão lógica de pessoal (ACV-09)"
    timestamp criado_em
    timestamp atualizado_em
  }
  AUTOR {
    uuid id PK
    string nome
    string nome_normalizado "dedup na ingestão (RN-12); UK fallback"
    string ol_author_key UK "nullable; UK parcial"
    string biografia "nullable; PENDENTE origem para ACV-10"
  }
  EDITORA {
    uuid id PK
    string nome
    string nome_normalizado UK "forma normalizada (RN-12)"
  }
  SERIE {
    uuid id PK
    string nome
    string nome_normalizado UK "RN-12"
  }
  ASSUNTO {
    uuid id PK
    string nome "conjunto curado e fechado ~30 gêneros (RN-21)"
    string slug UK
  }
  LIVRO_AUTOR {
    uuid livro_id PK, FK "somente livro oficial"
    uuid autor_id PK, FK
  }
  LIVRO_ASSUNTO {
    uuid livro_id PK, FK
    uuid assunto_id PK, FK "pessoal escolhe do curado (RN-21.5, ACV-22/P3)"
  }
  NOTA_LEITOR_PROJECAO {
    uuid usuario_id PK "→ usuario; projeção individual (P2)"
    uuid livro_id PK, FK "só livro oficial"
    decimal valor "0..5 passo 0,5"
    timestamp atualizado_em
  }
  NOTA_LIVRO_AGREGADA {
    uuid livro_id PK, FK "só livro oficial"
    decimal media "nota dos leitores (RN-06, P2)"
    int quantidade
    timestamp atualizado_em
  }
  IMPORTACAO_LIVRO {
    uuid id PK
    uuid solicitante_id "→ usuario"
    string isbn13 "normalizado (SEC-38 valida formato/dígito)"
    enum estado "pendente|concluida|nao_encontrado|falha_transitoria (ACV-05/06/07)"
    uuid livro_id FK "resultante, nullable; obrigatório se concluída"
    string erro "nullable"
    timestamp criado_em
    timestamp atualizado_em
  }
  SINONIMO_EDITORA {
    string forma_externa PK "texto livre da origem"
    uuid editora_id FK "tabela de sinônimos do grupo (RN-12)"
  }
  MAPA_ASSUNTO_EXTERNO {
    string tag_externa PK "tag livre da fonte"
    uuid assunto_id FK "mapeia p/ assunto curado; descarta não-mapeado (RN-21)"
  }
  INGESTAO_EXECUCAO {
    uuid id PK
    enum tipo "carga_inicial|delta|recarga (ACV-13/14)"
    enum status
    int total_processados
    int total_descartados
    int total_inseridos
    timestamp iniciado_em
    timestamp finalizado_em
  }
  IDEMPOTENCIA_ACERVO {
    uuid id PK "ledger HTTP técnico"
    uuid subject_ref "usuário/cliente opaco"
    string operacao "rota + ação"
    string chave
    string payload_hash "conflito se payload mudar"
    int status_http
    json resposta
    timestamp criado_em
    timestamp expira_em "UK(subject_ref,operacao,chave)"
  }

  %% CHECKs de LIVRO: oficial exige isbn13 e dono ausente; pessoal exige dono,
  %% autor_informado e isbn13 ausente. Livro pessoal não usa LIVRO_AUTOR,
  %% editora/série, nota geral nem NOTA_LIVRO_AGREGADA e fica fora do catálogo.
  %% PENDENTE acervo: confirmar chave do ol_dump_ratings/ol_work_key e a fonte
  %% da biografia antes das migrations das respectivas funcionalidades.

  %% ============================= schema leitura =============================
  ESTANTE ||--o{ LEITURA : "histórico (mesmo usuario+livro)"
  LEITURA ||--o{ ATUALIZACAO_PROGRESSO : "registra"
  LEITURA ||--o{ LIMIAR_INATIVIDADE : "processa"
  RESENHA ||--o{ REACAO_RESENHA : "recebe"
  DESAFIO ||--o{ JANELA_DESAFIO : "acumula"
  DESAFIO ||--o{ CONTRIBUICAO_DESAFIO : "recebe"
  DESAFIO ||--o{ PAUSA_DESAFIO : "pausa"
  JANELA_DESAFIO ||--o{ CONTRIBUICAO_DESAFIO : "consolida"

  ESTANTE {
    uuid id PK
    uuid usuario_id "→ usuario"
    uuid livro_id "→ acervo.livro; UK composto com usuario_id"
    enum status "quero_ler|lendo|lido|relendo|abandonado (RN-04)"
    int vezes_lido "conta só finalizadas (RN-04.4)"
    timestamp adicionado_em
    timestamp atualizado_em
  }
  LEITURA {
    uuid id PK
    uuid estante_id FK
    uuid usuario_id "→ usuario"
    uuid livro_id "→ acervo.livro"
    enum status "lendo|lido|abandonado"
    bool releitura "RN-04"
    bool incompleta "releitura abandonada; não retomável (RN-04)"
    date data_inicio "editável (EST-03)"
    date data_fim "editável, nullable (EST-04)"
    int pagina_atual "derivada = max(progresso.pagina) (RN-17.3)"
    timestamp ultima_atividade_em "contador de inatividade (RN-05)"
    int inatividade_versao "novo ciclo em progresso ou edição (RN-05)"
    timestamp criado_em
  }
  LIMIAR_INATIVIDADE {
    uuid id PK
    uuid leitura_id FK
    int inatividade_versao "ciclo da leitura"
    int limiar_dias "20|30|40"
    enum tipo "risco|expiracao"
    uuid event_id "fato publicado, nullable"
    timestamp processado_em
  }
  ATUALIZACAO_PROGRESSO {
    uuid id PK
    uuid leitura_id FK
    int pagina "absoluta; > pagina_atual e ≤ livro.paginas (RN-17, PRG-04)"
    int paginas_lidas "derivada (RN-17.1)"
    int minutos "tempo gasto (manual ou cronometrado)"
    timestamp registrado_em_dispositivo
    string fuso_horario_dispositivo "IANA"
    date data_local "derivada, p/ streak (RN-18.2)"
    string chave_idempotencia UK "fila offline (ERR-04/05)"
    timestamp criado_em
  }
  FAVORITO {
    uuid id PK "EST-09 (P2)"
    uuid usuario_id "→ usuario"
    uuid livro_id "→ acervo.livro; UK composto com usuario_id"
    timestamp criado_em
  }
  NOTA {
    uuid id PK
    uuid usuario_id "→ usuario"
    uuid livro_id "→ acervo.livro"
    decimal valor "0..5 passo 0,5 (RN-06)"
    timestamp criado_em
    timestamp atualizado_em "UK composto (usuario_id, livro_id)"
  }
  RESENHA {
    uuid id PK
    uuid usuario_id "→ usuario"
    uuid livro_id "→ acervo.livro"
    string texto "Markdown cru ≤5000 (RN-07/13)"
    bool spoiler "AVA-03"
    timestamp criado_em
    timestamp atualizado_em "UK composto (usuario_id, livro_id)"
  }
  REACAO_RESENHA {
    uuid id PK
    uuid resenha_id FK
    uuid usuario_id "→ usuario"
    enum tipo "curtida|descurtida (AVA-05, P2)"
    timestamp criado_em "UK composto (resenha_id, usuario_id)"
  }
  FRASE {
    uuid id PK
    uuid usuario_id "→ usuario"
    uuid livro_id "→ acervo.livro"
    string texto "≤500 (RN-11, P2)"
    int pagina "obrigatória (RN-11)"
    timestamp criado_em
  }
  DESAFIO {
    uuid id PK
    uuid usuario_id "→ usuario"
    enum unidade "paginas|minutos|livros (RN-20, P2)"
    enum janela "diaria|semanal|mensal|anual (RN-20)"
    int valor_alvo
    bool pausado "não acumula (RN-20.6)"
    timestamp criado_em
    timestamp atualizado_em
  }
  JANELA_DESAFIO {
    uuid id PK
    uuid desafio_id FK
    date inicio "janela de calendário (RN-20.1)"
    date fim
    int acumulado
    bool cumprida "histórico retido em DSF-05/P3"
  }
  CONTRIBUICAO_DESAFIO {
    uuid id PK "efeito idempotente (P2)"
    uuid desafio_id FK
    uuid janela_id FK
    enum origem_tipo "progresso|leitura_finalizada"
    uuid origem_id "fato no schema leitura"
    int valor
    timestamp ocorrido_em
    date data_local "define janela de calendário"
    timestamp criado_em "UK(desafio_id, origem_tipo, origem_id)"
  }
  PAUSA_DESAFIO {
    uuid id PK "intervalo mínimo da janela corrente (P2)"
    uuid desafio_id FK
    timestamp inicio_em
    timestamp fim_em "nullable enquanto pausado"
  }
  SEQUENCIA_LEITURA {
    uuid usuario_id PK "→ usuario"
    int sequencia_atual "RN-18 (P2)"
    int maior_sequencia "preservada ao zerar (RN-18.6)"
    date ultimo_dia
    string ultimo_fuso_horario "IANA; zeramento derivado (P2)"
    timestamp atualizado_em
  }
  DIA_LEITURA {
    uuid usuario_id PK "→ usuario"
    date data PK "data local; base do streak (P2)"
  }
  ESTATISTICA_ANUAL {
    uuid usuario_id PK "→ usuario"
    int ano PK
    int livros_concluidos "STA-01 (P2)"
    int paginas_lidas
    int minutos_lidos
    timestamp recalculado_em "recálculo assíncrono (STA-05)"
  }
  ESTATISTICA_MENSAL {
    uuid usuario_id PK "→ usuario"
    int ano PK
    int mes PK "1..12"
    int livros_concluidos "série RF-STA-03 (P2)"
    int paginas_lidas "série RF-STA-03"
    int minutos_lidos
    timestamp recalculado_em
  }
  ESTATISTICA_USUARIO {
    uuid usuario_id PK "→ usuario; acumulado/médias (P2)"
    int livros_concluidos
    int paginas_lidas
    int minutos_lidos
    int dias_com_leitura "denominador páginas/dia"
    int dias_em_livros_concluidos "denominador dias/livro"
    decimal nota_media "média atual atribuída"
    timestamp recalculado_em
  }
  IDEMPOTENCIA_LEITURA {
    uuid id PK "ledger HTTP técnico"
    uuid subject_ref "usuário/cliente opaco"
    string operacao "rota + ação"
    string chave
    string payload_hash "conflito se payload mudar"
    int status_http
    json resposta
    timestamp criado_em
    timestamp expira_em "UK(subject_ref,operacao,chave)"
  }

  %% Constraints: uma leitura em andamento por (usuario,livro); um limiar por
  %% (leitura,inatividade_versao,limiar_dias); um favorito por (usuario,livro);
  %% máximo 10 FRASE por (usuario,livro); uma janela por desafio+intervalo.
  %% Limiar risco aceita só 20/30 e expiracao só 40. Excluir progresso remove
  %% suas contribuições, recalcula página/estatísticas e reavalia DIA_LEITURA
  %% apenas pelos demais progressos qualificáveis daquele usuário+dia.
  %% Histórico de leitura e total acumulado de estatísticas derivam dos fatos.
  %% PENDENTE leitura: promoção de progresso.registrado/leitura.finalizada e
  %% mecanismo durável de RNF-ERR-10; não criar outbox antes da decisão.

  %% ============================= schema social =============================
  ATIVIDADE ||--o{ CURTIDA_ATIVIDADE : "recebe"
  ATIVIDADE ||--o{ COMENTARIO : "recebe"
  COMENTARIO o|--o{ COMENTARIO : "raiz opcional (1 nível, RN-10)"
  COMENTARIO ||--o{ COMENTARIO_MENCAO : "resolve"
  LISTA ||--o{ LISTA_ITEM : "contém"
  DENUNCIA o|--o{ LOG_MODERACAO : "resolução opcional"

  ATIVIDADE {
    uuid id PK
    uuid autor_id "→ usuario"
    enum tipo "leitura_iniciada|leitura_retomada|leitura_concluida|leitura_abandonada|resenha_publicada (RN-09)"
    uuid livro_id "→ acervo.livro (ref)"
    uuid event_id UK "dedup do evento consumido"
    string chave_fato "UK composto com tipo"
    enum origem_tipo "leitura|resenha"
    uuid origem_id "id no schema leitura; sem FK física"
    string snap_usuario_nome "snapshot no evento (arq §3.2.4)"
    string snap_usuario_username
    string snap_usuario_avatar
    string snap_livro_titulo
    string snap_livro_autor
    string snap_livro_capa
    bool ativo "some se livro/atividade removidos (RN-09)"
    timestamp criado_em
  }
  CURTIDA_ATIVIDADE {
    uuid id PK
    uuid atividade_id FK
    uuid usuario_id "→ usuario"
    timestamp criado_em "UK composto (atividade_id, usuario_id)"
  }
  COMENTARIO {
    uuid id PK
    uuid atividade_id FK
    uuid autor_id "→ usuario"
    uuid comentario_raiz_id FK "self nullable; excluir raiz remove respostas (RN-10.5)"
    uuid respondido_usuario_id "→ usuario alvo da resposta (SOC-14), nullable"
    string texto "menções @username no texto cru (RN-10, SEC-14)"
    timestamp criado_em
    timestamp atualizado_em "SOC-13 (P2)"
    timestamp excluido_em "nullable"
  }
  COMENTARIO_MENCAO {
    uuid id PK "SOC-15 (P2)"
    uuid comentario_id FK
    uuid mencionado_id "→ usuario"
    int posicao "posição no texto cru"
    timestamp criado_em "UK composto (comentario_id, mencionado_id)"
  }
  LISTA {
    uuid id PK
    uuid usuario_id "→ usuario"
    string titulo
    string descricao "nullable"
    bool ativo
    timestamp criado_em
    timestamp atualizado_em
  }
  LISTA_ITEM {
    uuid id PK
    uuid lista_id FK
    uuid livro_id "→ acervo.livro; pessoal só do próprio dono (RN-15)"
    int ordem "UK com lista_id; reordenável (LST-02)"
    timestamp adicionado_em "UK composto (lista_id, livro_id)"
  }
  RECOMENDACAO {
    uuid id PK
    uuid remetente_id "→ usuario"
    uuid destinatario_id "→ usuario"
    uuid livro_id "→ acervo.livro (não pessoal, REC-06)"
    string mensagem "opcional (REC-03)"
    uuid event_id UK "evento de notificação, nullable"
    timestamp criado_em
    timestamp expira_em "90 dias (RN-22); sem estado de aceitação (P2)"
  }
  SUGESTAO_DESCARTADA {
    uuid id PK
    uuid usuario_id "→ usuario"
    uuid livro_id "→ acervo.livro"
    timestamp descartado_em "UK(usuario_id, livro_id); não reaparece (REC-12, P3)"
  }
  NOTIFICACAO {
    uuid id PK
    uuid destinatario_id "→ usuario"
    enum tipo "novo_seguidor|solicitacao_seguir|solicitacao_aceita|atividade_curtida|atividade_comentada|comentario_respondido|usuario_mencionado|recomendacao_recebida|lembrete_sequencia|resenha_curtida|leitura_em_risco|leitura_expirada (NOT-01)"
    json dados "snapshot/refs"
    uuid leitura_ref "ação abandonar (NOT-04), nullable"
    timestamp lida_em "nullable; ausência significa não lida"
    uuid event_id UK "dedup de entrega"
    string chave_negocio "UK(destinatario_id, tipo, chave_negocio)"
    timestamp criado_em
  }
  PREFERENCIA_NOTIFICACAO {
    uuid usuario_id PK "→ usuario"
    enum categoria PK "PENDENTE mapa tipo→categoria (P3)"
    bool habilitada "NOT-05 (P3)"
  }
  DISPOSITIVO_PUSH {
    uuid id PK
    uuid usuario_id "→ usuario"
    string fcm_token UK
    enum plataforma "android (NOT-07, P3)"
    bool ativo
    timestamp criado_em
    timestamp atualizado_em
    timestamp revogado_em "nullable"
  }
  DENUNCIA {
    uuid id PK
    uuid denunciante_id "→ usuario"
    enum alvo_tipo "resenha|comentario (MOD-01, P2)"
    uuid alvo_id "resenha@leitura ou comentario@social (ref)"
    enum motivo
    string descricao "nullable"
    enum estado "pendente|removida|arquivada (MOD-03)"
    timestamp criado_em
    timestamp resolvido_em "nullable"
  }
  LOG_MODERACAO {
    uuid id PK
    string admin "conta admin por ambiente (env)"
    enum acao "remover_conteudo|arquivar_denuncia|suspender_conta (MOD-05, SEC-37)"
    enum alvo_tipo "resenha|comentario|frase|usuario"
    uuid alvo_id
    uuid denuncia_id "nullable"
    string detalhe
    timestamp criado_em
  }
  IDEMPOTENCIA_SOCIAL {
