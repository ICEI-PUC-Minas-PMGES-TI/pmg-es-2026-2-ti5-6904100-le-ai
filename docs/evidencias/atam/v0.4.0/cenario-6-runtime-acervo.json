  "info": {
    "title": "Lê Ai — acervo",
    "description": "Contrato do serviço acervo. Cadastro por ISBN e livro pessoal entregues por F-ACV-CADASTRO; busca e página do livro seguem planejadas.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SolicitarImportacaoDto": {
        "type": "object",
        "properties": {
          "isbn": {
            "type": "string",
            "minLength": 13,
            "maxLength": 17,
            "example": "978-85-359-1484-9",
            "description": "ISBN-13; separadores podem ser normalizados pelo servidor."
          }
        },
        "required": [
          "isbn"
        ]
      },
      "ImportacaoAceitaDto": {
        "type": "object",
        "properties": {
          "importacaoId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pendente"
            ]
          }
        },
        "required": [
          "importacaoId",
          "status"
        ]
      },
      "LivroImportadoResumoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "titulo": {
            "type": "string"
          },
          "autores": {
            "type": "string",
            "nullable": true,
            "description": "Autores para exibição, separados por vírgula."
          },
          "editora": {
            "type": "string",
            "nullable": true
          },
          "anoPublicacao": {
            "type": "number",
            "nullable": true
          },
          "paginas": {
            "type": "number",
            "minimum": 1
          },
          "capaUrl": {
            "type": "string",
            "nullable": true,
            "description": "Capa resolvida: cópia própria, senão URL externa."
          }
        },
        "required": [
          "id",
          "titulo",
          "autores",
          "editora",
          "anoPublicacao",
          "paginas",
          "capaUrl"
        ]
      },
      "ImportacaoDto": {
        "type": "object",
        "properties": {
          "importacaoId": {
            "type": "string",
            "format": "uuid"
          },
          "isbn": {
            "type": "string",
            "pattern": "^97[89][0-9]{10}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "pendente",
              "concluida",
              "nao_encontrado",
              "falha_transitoria"
            ],
            "description": "nao_encontrado significa que todas as fontes responderam sem o ISBN; falha_transitoria significa indisponibilidade após as retentativas. Os dois não se confundem."
          },
          "livroId": {
            "type": "object",
            "format": "uuid",
            "nullable": true,
            "description": "Preenchido somente quando status é concluida."
          },
          "livro": {
            "nullable": true,
            "description": "Resumo do livro, somente quando status é concluida.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/LivroImportadoResumoDto"
              }
            ]
          },
          "permiteCadastroPessoal": {
            "type": "boolean",
            "description": "true somente quando status é nao_encontrado."
          },
          "criadoEm": {
            "type": "string",
            "format": "date-time"
          },
          "atualizadoEm": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "importacaoId",
          "isbn",
          "status",
          "livroId",
          "livro",
          "permiteCadastroPessoal",
          "criadoEm",
          "atualizadoEm"
        ]
      },
      "LivroPessoalEntradaDto": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "example": "Caderno de viagem"
          },
          "autor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "Marina Albuquerque"
          },
          "paginas": {
            "type": "number",
            "minimum": 1,
            "example": 180
          },
          "sinopse": {
            "type": "object",
            "maxLength": 4000,
            "nullable": true
          },
          "capaUrl": {
            "type": "object",
            "format": "uri",
            "nullable": true,
            "description": "URL do asset já enviado diretamente ao serviço de imagens."
          },
          "assuntos": {
            "maxItems": 100,
            "nullable": true,
