    "/livros": {
      "get": {
        "description": "Busca por título, autor, editora, assunto ou ISBN-13, sem acento e por trecho, com filtros opcionais por assunto (RF-ACV-02) e por autor, editora, série, ano e faixa de páginas (RF-ACV-03), todos combináveis. Algum critério é obrigatório. Livro pessoal nunca aparece (RNF-SEC-06). As edições de mesmo título e autores chegam contíguas (RN-01).",
        "operationId": "buscarLivrosOficiais",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100000,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "schema": {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            }
          },
          {
            "name": "assunto",
            "required": false,
            "in": "query",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "autor",
            "required": false,
            "in": "query",
            "schema": {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            }
          },
          {
            "name": "editora",
            "required": false,
            "in": "query",
            "schema": {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            }
          },
          {
            "name": "serie",
            "required": false,
            "in": "query",
            "schema": {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            }
          },
          {
            "name": "ano",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 9999,
              "type": "number"
            }
          },
          {
            "name": "paginasMin",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100000,
              "type": "number"
            }
          },
          {
            "name": "paginasMax",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100000,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaLivrosDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Busca livros oficiais",
        "tags": [
          "livros"
        ]
      }
    },
